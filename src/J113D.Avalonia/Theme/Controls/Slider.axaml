<ResourceDictionary 
	xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:sys="using:System">

	<Design.PreviewWith>
		<Border Margin="10" Padding="10" Width="400" Height="600" Background="{DynamicResource BackgroundColor1}">
			<DockPanel LastChildFill="True">
				<StackPanel Spacing="10" DockPanel.Dock="Top">
					<Slider Value="50" />
					<Slider IsEnabled="False" Value="50" />
					<Slider Value="50">
						<DataValidationErrors.Error>
							<sys:Exception>
								<x:Arguments>
									<x:String>Error</x:String>
								</x:Arguments>
							</sys:Exception>
						</DataValidationErrors.Error>
					</Slider>
				</StackPanel>
				<StackPanel Spacing="10" Orientation="Horizontal">
					<Slider Value="50" Orientation="Vertical" />
					<Slider IsEnabled="False" Orientation="Vertical" Value="50" />
				</StackPanel>
			</DockPanel>
		</Border>
	</Design.PreviewWith>

	<x:Double x:Key="SliderSize">32</x:Double>
	<x:Double x:Key="SliderTrackThemeSize">12</x:Double>
	<x:Double x:Key="SliderOutsideTickBarThemeHeight">4</x:Double>

	<ControlTheme x:Key="J113DSliderHorizontalRepeatButton" TargetType="RepeatButton">
		<Setter Property="Template">
			<ControlTemplate>
				<Grid>
					<Border 
						Name="FocusTarget" 
						Margin="0,-10" 
						Background="Transparent" />
					
					<Border 
						Name="TrackBackground"
						Background="{TemplateBinding Background}"
						CornerRadius="{TemplateBinding CornerRadius}"
						Height="{DynamicResource SliderTrackThemeSize}"
						VerticalAlignment="Center"/>
				</Grid>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<ControlTheme x:Key="J113DSliderVerticalRepeatButton" TargetType="RepeatButton">
		<Setter Property="Template">
			<ControlTemplate>
				<Grid>
					<Border
						Name="FocusTarget"
						Margin="0,-10"
						Background="Transparent" />

					<Border
						Name="TrackBackground"
						Background="{TemplateBinding Background}"
						CornerRadius="{TemplateBinding CornerRadius}"
						Width="{DynamicResource SliderTrackThemeSize}"
						HorizontalAlignment="Center"/>
				</Grid>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<ControlTheme x:Key="J113DSliderThumbTheme" TargetType="Thumb">
		<Setter Property="Template">
			<ControlTemplate>
				<Border
					Background="{TemplateBinding BorderBrush}"
					CornerRadius="5"
					Padding="2">
					
					<Border
						Background="{TemplateBinding Background}"
						CornerRadius="3"/>

				</Border>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
		<Setter Property="Background" Value="{DynamicResource BackgroundColor3}" />
		<Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
		
		<Style Selector="^:horizontal">
			<Setter Property="Template">
				<ControlTemplate>
					<DataValidationErrors>
						<Track
							Name="PART_Track"
							Margin="{TemplateBinding Padding}"
							MinHeight="{DynamicResource SliderSize}"
							Minimum="{TemplateBinding Minimum}"
							Maximum="{TemplateBinding Maximum}"
							Value="{TemplateBinding Value, Mode=TwoWay}"
							Orientation="Horizontal">
										
							<Track.DecreaseButton>
								<RepeatButton
									Name="PART_DecreaseButton"
									Theme="{StaticResource J113DSliderHorizontalRepeatButton}"
									Background="{TemplateBinding Foreground}"
									Focusable="False"
									CornerRadius="3 0 0 3"/>
							</Track.DecreaseButton>
										
							<Track.IncreaseButton>
								<RepeatButton
									Name="PART_IncreaseButton"
									Theme="{StaticResource J113DSliderHorizontalRepeatButton}"
									Background="{TemplateBinding Background}"
									Focusable="False"
									CornerRadius="0 3 3 0"/>
							</Track.IncreaseButton>
										
							<Thumb
								Name="thumb"
								Width="16"
								Height="32"
								Background="{DynamicResource AccentColor}"
								Theme="{StaticResource J113DSliderThumbTheme}"
								DataContext="{TemplateBinding Value}"/>
						</Track>
					</DataValidationErrors>
				</ControlTemplate>
			</Setter>
		</Style>
		
		<Style Selector="^:vertical">
			<Setter Property="Template">
				<ControlTemplate>
					<DataValidationErrors>
						<Track
							Name="PART_Track"
							Margin="{TemplateBinding Padding}"
							MinWidth="{DynamicResource SliderSize}"
							Minimum="{TemplateBinding Minimum}"
							Maximum="{TemplateBinding Maximum}"
							Value="{TemplateBinding Value, Mode=TwoWay}"
							Orientation="Vertical">
							
							<Track.DecreaseButton>
								<RepeatButton
									Name="PART_DecreaseButton"
									Theme="{StaticResource J113DSliderVerticalRepeatButton}"
									Background="{TemplateBinding Foreground}"
									Focusable="False"
									CornerRadius="0 0 3 3"/>
							</Track.DecreaseButton>
							
							<Track.IncreaseButton>
								<RepeatButton
									Name="PART_IncreaseButton"
									Background="{TemplateBinding Background}"
									Theme="{StaticResource J113DSliderVerticalRepeatButton}"
									Focusable="False"
									CornerRadius="3 3 0 0"/>
							</Track.IncreaseButton>
							
							<Thumb
								Name="SliderThumb"
								Width="32"
								Height="16"
								Background="{DynamicResource AccentColor}"
								Theme="{StaticResource J113DSliderThumbTheme}"
								DataContext="{TemplateBinding Value}" />
						</Track>
					</DataValidationErrors>
				</ControlTemplate>
			</Setter>
		</Style>


		<!--  PointerOver State  -->
		<Style Selector="^:pointerover">
			<Style Selector="^ /template/ Thumb">
				<Setter Property="Background" Value="{DynamicResource HighlightedAccentColor}" />
				<Setter Property="BorderBrush" Value="{DynamicResource PressedAccentColor}" />
			</Style>
		</Style>

		<!--  Pressed State  -->
		<Style Selector="^:pressed">
			<Style Selector="^ /template/ Thumb">
				<Setter Property="Background" Value="{DynamicResource PressedAccentColor}" />
				<Setter Property="BorderBrush" Value="{DynamicResource PressedAccentColor}" />
			</Style>
		</Style>

		<!--  Disabled State  -->
		<Style Selector="^:disabled">
			<Setter Property="Foreground" Value="{DynamicResource DisabledAccentColor}" />
			<Setter Property="Background" Value="{DynamicResource BackgroundColor4}" />
			<Style Selector="^ /template/ Thumb">
				<Setter Property="Background" Value="{DynamicResource DisabledAccentColor}" />
			</Style>
		</Style>

		<Style Selector="^:error">
			<Setter Property="Foreground" Value="{DynamicResource RedColor}" />
			<Style Selector="^ /template/ Thumb">
				<Setter Property="Background" Value="{DynamicResource RedColor}" />
			</Style>
		</Style>

	</ControlTheme>

</ResourceDictionary>
